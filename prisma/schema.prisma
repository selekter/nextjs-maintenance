generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Truck {
  id              Int       @id @default(autoincrement())
  license_plate   String    @unique @db.VarChar(255)
  current_mileage Int       @default(0)
  created_at      DateTime? @default(now()) @db.Timestamp(0)
  updated_at      DateTime? @updatedAt @db.Timestamp(0)
  driver_id       Int?      @unique
  driver          Driver?   @relation(fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  reports             Report[]
  tireChangeHistories TireChangeHistory[]
  MaintenanceStatuses TruckMaintenanceStatus[]

  @@index([driver_id])
  @@map("trucks")
}

model Driver {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  trucks     Truck?

  @@map("drivers")
}

model Report {
  id          Int      @id @default(autoincrement())
  truck_id    Int
  repair      String   @db.VarChar(255)
  status      Int      @default(0)
  mileage     Int      @default(0)
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  truck       Truck    @relation(fields: [truck_id], references: [id])

  @@index([status, updated_at(sort: Desc)])
  @@index([truck_id])
  @@map("report_repairs")
}

model TireChangeHistory {
  id                Int        @id @default(autoincrement())
  truck_id          Int
  change_date       DateTime   @default(now())
  mileage_at_change Int
  notes             String?    @db.Text
  truck             Truck      @relation(fields: [truck_id], references: [id])
  tireItems         TireItem[]

  @@index([truck_id])
  @@map("tire_change_history")
}

model TireBrand {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  items TireItem[]

  @@map("tire_brand")
}

model TireItem {
  id             Int               @id @default(autoincrement())
  tire_change_id Int
  brand_id       Int
  tire_code      String
  position       Int
  brand          TireBrand         @relation(fields: [brand_id], references: [id])
  history        TireChangeHistory @relation(fields: [tire_change_id], references: [id])

  @@index([tire_change_id])
  @@index([brand_id])
  @@map("tire_item")
}

// ตารางเก็บ "สถานะล่าสุด" โดยเฉพาะ (1 รถ : 3 ประเภทน้ำมัน = มีสูงสุด 3 แถวต่อรถ 1 คัน)
model TruckMaintenanceStatus {
  id              Int      @id @default(autoincrement())
  truck_id        Int
  type            String
  service_mileage Int      @default(0)
  next_service_at Int      @default(0)
  service_date    DateTime @updatedAt

  truck Truck @relation(fields: [truck_id], references: [id], onDelete: Cascade)

  @@unique([truck_id, type])
  @@map("truck_maintenance_statuses")
}

model User {
  id            String    @id
  name          String    @db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId(length: 191)])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId(length: 191)])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}
